# ─────────────────────────────────────────────────────────────────────────────
# Vercel — WEB service production env (SignalFrame MVP @ gengrowth.ai/app)
# Deploy the CURRENT HEAD of main (git rev-parse --short HEAD) — it includes
# render.yaml + the /app base path. Do NOT deploy eabaab3 (predates render.yaml).
#
# HOW TO USE: set these in the Vercel project → Settings → Environment Variables
# (scope: Production). This file is a TEMPLATE with placeholders — never paste
# real secret values here or commit them. [secret] = set in dashboard only.
# See docs/LAUNCH-CHECKLIST.md (Phase 4) and docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- BUILD TIME (must be present at build; mounts the app under /app) ---
NEXT_PUBLIC_BASE_PATH=/app

# --- shared ---
APP_ORIGIN=https://gengrowth.ai                 # origin ONLY — no /app suffix
DATABASE_URL=REPLACE_ME                          # [secret] Supabase SESSION/direct mode (never the transaction pooler)
DB_POOL_MAX=3
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME             # [secret]
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME             # [secret] 32-byte base64 (openssl rand -base64 32) — MUST match the worker
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME            # [secret]
DATAFORSEO_ENABLED=false                         # MUST be false (MVP)
RAW_IMPORT_BUCKET=raw-imports
EXPORT_BUCKET=exports
SF_BLOB_BACKEND=supabase                          # production must be supabase (never local)
LOG_LEVEL=info

# --- web only ---
SUPABASE_ANON_KEY=REPLACE_ME                     # [secret] browser client

# --- release identity ---
# Leave APP_BUILD_SHA UNSET: Vercel auto-provides VERCEL_GIT_COMMIT_SHA, so
# /health/version reports the ACTUAL deployed SHA. Only set APP_BUILD_SHA to
# override (a hardcoded value that mismatches the deploy is worse than none).
# APP_BUILD_SHA=

# --- DO NOT SET on web/prod ---
# SF_DEV_AUTH        (local-only auth bypass; prod ignores it — keep it absent)
# SF_BLOB_DIR        (local filesystem backend only)
# NEXT ... LLM vars  (OPENAI_*/AZURE_* live on the WORKER, not web)
