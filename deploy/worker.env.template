# ─────────────────────────────────────────────────────────────────────────────
# WORKER service production env (SignalFrame MVP pg-boss consumer)
# Deploy only a clean, fully verified immutable SHA — never an arbitrary current
# HEAD or a shared dirty worktree.
#
# Approved production host (Owner decision 2026-07-20): one Railway Hobby
# worker-only service built from railway.json / Dockerfile.worker. Railway does
# NOT host the web; Vercel is the only production web runtime.
# TEMPLATE with placeholders — never paste real secret values here or commit
# them. [secret] = dashboard only. See docs/DEPLOY-GUIDE-zh.md step 3. The
# worker has NO domain, HTTP port, or HTTP healthcheck. Its live Supabase lease
# drives the Vercel web /api/mvp/health/ready gate.
# ─────────────────────────────────────────────────────────────────────────────

# --- shared (MUST match the web service; same DB, key, OAuth, buckets) ---
APP_ORIGIN=https://app.gengrowth.ai
DATABASE_URL=REPLACE_ME                          # [secret] Supabase SESSION/direct mode (never the transaction pooler)
DB_POOL_MAX=2                               # minimum 2: readiness holds one Drizzle connection for the worker lifetime
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME             # [secret] must have create/read/list/delete on both buckets
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME             # [secret] 32-byte base64 — MUST be identical to the web value
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME            # [secret]
DATAFORSEO_ENABLED=true                          # production Analysis Refresh + worker collection
DATAFORSEO_BACKLINKS_ENABLED=false               # separate default-off rollout; requires DATAFORSEO_ENABLED=true
DATAFORSEO_MAX_KEYWORDS=200                      # ranked-keyword cost/row cap; 1..1000
DATAFORSEO_MAX_COMPETITORS=100                   # competitor-domain cost/row cap; 1..1000
DATAFORSEO_MAX_BACKLINKS=500                     # live backlink-row cap; 1..1000
DATAFORSEO_MAX_REFERRING_DOMAINS=100             # referring-domain cap; 1..1000
DATAFORSEO_MAX_BACKLINK_PAGES=500                # linked target-page cap; 1..1000
DATAFORSEO_MAX_BACKLINK_SOURCE_VERIFICATIONS=20  # SSRF-safe source checks; 0..20 and <= backlink cap
DATAFORSEO_LOGIN=REPLACE_ME                      # [secret] worker only; never set on Vercel
DATAFORSEO_PASSWORD=REPLACE_ME                   # [secret] worker only; never set on Vercel
RAW_IMPORT_BUCKET=raw-imports
EXPORT_BUCKET=exports
SF_BLOB_BACKEND=supabase                          # production must be supabase (never local)
LOG_LEVEL=info

# --- worker only: LLM (spec §10.2) ---
# Option A — direct OpenAI (comment out the Azure block below):
LLM_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME                         # [secret]
OPENAI_MODEL=REPLACE_ME                           # pin an explicit model id (e.g. gpt-4.1-mini)
FINDING_SUMMARIES_ENABLED=true                    # true|false; optional localized finding summaries
# Manual runtime-supported variant — Azure OpenAI (same provider, different
# host). Obtain a separate configuration review, provide ALL FOUR or NONE, and
# remove the direct fields above:
# AZURE_OPENAI_API_KEY=REPLACE_ME                 # [secret]
# AZURE_OPENAI_ENDPOINT=https://REPLACE_ME.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=REPLACE_ME
# OPENAI_API_VERSION=REPLACE_ME

# --- release identity ---
# Leave APP_BUILD_SHA UNSET: Railway auto-provides RAILWAY_GIT_COMMIT_SHA (read
# by the version resolver), so the worker's startup logs report the ACTUAL
# deployed SHA. Only set APP_BUILD_SHA to the exact immutable <release SHA> when
# an explicit override is required. The Vercel web and Railway worker must report
# the same SHA before app.gengrowth.ai is promoted.
# APP_BUILD_SHA=

# --- DO NOT SET on the worker ---
# NEXT_PUBLIC_BASE_PATH   (web-only; worker has no HTTP routes)
# SUPABASE_ANON_KEY       (browser-only)
# SF_DEV_AUTH / SF_BLOB_DIR (local-only)
