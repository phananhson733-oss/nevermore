{
  "name": "signalframe-mvp-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.12 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "verify:spec": "node ../signalframe-mvp/implementation-spec-v0.2/scripts/verify-spec.mjs",
    "openapi:lint": "redocly lint openapi/mvp.yaml --config ../signalframe-mvp/implementation-spec-v0.2/redocly.yaml",
    "contracts:generate": "pnpm --filter @sf/contracts generate",
    "contracts:check": "pnpm --filter @sf/contracts check",
    "db:migrate": "pnpm --filter @sf/db migrate",
    "db:migrate:check": "pnpm --filter @sf/db migrate:check",
    "db:smoke": "pnpm --filter @sf/db smoke",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "vendor:check": "node scripts/check-vendor-baseline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@redocly/cli": "2.39.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
