{
  "name": "signalframe-mvp-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.12 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "8.5.19",
      "js-yaml@<4.3.0": "4.3.0"
    }
  },
  "scripts": {
    "lint": "pnpm lint:e2e && pnpm -r --if-present lint",
    "lint:e2e": "eslint e2e",
    "typecheck": "pnpm typecheck:e2e && pnpm -r --if-present typecheck",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "build": "pnpm -r --if-present build",
    "artifact:build": "node scripts/build-static-customer-artifact.mjs",
    "artifact:manual": "node scripts/build-product-manual.mjs",
    "artifact:keyword-audit": "node scripts/build-keyword-audit-artifact.mjs",
    "artifact:keyword-audit:verify": "node --test scripts/verify-keyword-audit-data.test.mjs && node scripts/verify-keyword-audit-artifact.cjs",
    "artifact:verify": "node --test scripts/artifact-path-guard.test.cjs && node scripts/verify-static-customer-artifact.cjs && node scripts/verify-product-manual.cjs && pnpm artifact:keyword-audit:verify",
    "artifact:regen": "pnpm artifact:build && pnpm artifact:manual && pnpm artifact:keyword-audit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "coverage:unit-gaps": "node scripts/report-unit-coverage-gaps.mjs",
    "test:e2e": "pnpm test:e2e:real && pnpm test:e2e:mock",
    "test:e2e:artifact": "playwright test --config=playwright.artifact.config.ts",
    "test:e2e:keyword-audit": "pnpm artifact:keyword-audit && pnpm artifact:keyword-audit:verify && playwright test --config=playwright.keyword-audit.config.ts",
    "test:e2e:real": "playwright test --config=playwright.config.ts",
    "test:e2e:mock": "playwright test --config=playwright.mock.config.ts",
    "verify:docs": "node --test scripts/verify-docs-consistency.test.mjs",
    "verify:authority": "node authority/implementation-spec-v0.3/scripts/verify-spec.mjs",
    "verify:spec": "node scripts/verify-spec-lock.mjs",
    "verify:spec:test": "node --test scripts/verify-docs-consistency.test.mjs scripts/verify-spec-lock.test.mjs scripts/verify-implementation-source.test.mjs authority/implementation-spec-v0.3/scripts/verify-spec.test.mjs",
    "openapi:lint": "redocly lint openapi/mvp.yaml --config openapi/redocly.yaml",
    "contracts:generate": "pnpm --filter @sf/contracts generate",
    "contracts:check": "pnpm --filter @sf/contracts check",
    "db:migrate": "pnpm --filter @sf/db migrate",
    "db:migrate:check": "pnpm --filter @sf/db migrate:check",
    "db:smoke": "pnpm --filter @sf/db smoke",
    "restore:drill": "node scripts/backup-restore-drill.mjs",
    "restore:drill:test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/backup-restore-drill.test.mjs",
    "implementation:check": "node scripts/verify-implementation.mjs",
    "deploy:check": "node scripts/verify-deploy-config.mjs",
    "secrets:scan": "node scripts/secrets-scan.mjs && vitest run --project unit apps/worker/src/export/run-export.test.ts apps/worker/src/export/__tests__/export-redact.test.ts packages/observability/src/__tests__/logger-redact.test.ts packages/db/src/__tests__/telemetry-redact.test.ts",
    "vendor:check": "node scripts/check-vendor-baseline.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@redocly/cli": "2.39.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "29.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
