.git
.gitignore
node_modules
**/node_modules
.pnpm-store
**/.next
**/.next-*
dist
**/dist
coverage
playwright-report
test-results
.vitest
.data
**/.data

# Operator documentation and local verification evidence are not runtime build
# inputs. Excluding them also lets docs record an image digest without changing
# that same image on the next reproducible build.
docs

# Never copy local credentials, backups, or future env-file variants into the
# build context. Docker builds do not need env examples at runtime.
.env*
**/.env*

.DS_Store
*.tsbuildinfo
