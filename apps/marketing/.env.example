# GenGrowth marketing website. Configure production values in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Identity Services client id. Enables the existing Google sign-in
# button used by registration-gated Agent runs; this is identity, not Gmail.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Production only. Leave unset on localhost and *.vercel.app previews.
SESSION_COOKIE_DOMAIN=
# Server-side durable crawl quota/cache. The current helper also accepts the
# newer SUPABASE_URL + SUPABASE_SECRET_KEY names.
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent root for sealed marketing OAuth cookies (base64, 32+
# decoded bytes). TOKEN_ENCRYPTION_KEY remains the backwards-compatible root.
MARKETING_COOKIE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
UNSUBSCRIBE_SECRET=
## Keep true only while published blog_posts rows are being migrated to content/blog.
## Local Markdown always takes precedence for the same locale + slug.
BLOG_LEGACY_SUPABASE_ENABLED=true

# Server-only GEO providers for gengrowth.ai. Never expose these names or their
# values through a NEXT_PUBLIC_* variable. DataForSEO powers repeated
# per-question sampling for AI Visibility and one-answer sampling for GEO Brief;
# Brief assembly is a separate provider call with its own budget and off-switch.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional, explicit Page Citability semantic review. Uses the credentials above
# only after verified sign-in, snapshot matching and durable quota admission.
# No web search; model wording does not replace measured checks or verify facts.
# Omit to use gpt-4.1-mini. Before enabling, verify the exact model through the
# free DataForSEO LLM Responses models endpoint. An empty/unknown value fails closed.
# CITABILITY_AI_MODEL_NAME=gpt-4.1-mini

# Optional isolated Linux Chromium service for comparable JS-off/on body capture.
# Keep this service/token separate from provider credentials and the Next bundle.
# Missing or partial renderer evidence stays unknown, never a synthetic zero.
# CITABILITY_RENDERER_URL=https://<trusted-renderer-service>/render
# CITABILITY_RENDERER_TOKEN=<dedicated-renderer-token>

# GEO Brief assembly is fail-closed in this example. Leave both profiles below
# commented to keep it disabled. To enable it, choose exactly one complete
# five-line profile, replace every placeholder, and uncomment every line. Do not
# combine profiles or set only GEO_BRIEF_API_KEY and GEO_BRIEF_MODEL. Runtime
# keeps backwards-compatible Direct defaults for omitted URL/auth/temperature,
# so the provider gate is not a five-field completeness check: set and verify
# every line in the chosen production profile.

# Direct OpenAI-compatible profile:
# GEO_BRIEF_API_KEY=<openai-api-key>
# GEO_BRIEF_MODEL=<openai-model>
# GEO_BRIEF_URL=https://api.openai.com/v1/chat/completions
# GEO_BRIEF_AUTH_SCHEME=bearer
# GEO_BRIEF_TEMPERATURE=0.2

# Azure OpenAI profile. MODEL is the deployment name, URL is the full deployment
# Chat Completions URL including api-version, auth is api-key, and the current
# gpt-5.6-luna deployment requires temperature 1:
# GEO_BRIEF_API_KEY=<azure-openai-api-key>
# GEO_BRIEF_MODEL=<azure-deployment-name>
# GEO_BRIEF_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment-name>/chat/completions?api-version=<api-version>
# GEO_BRIEF_AUTH_SCHEME=api-key
# GEO_BRIEF_TEMPERATURE=1

# If GEO_BRIEF_TEMPERATURE is present but empty, whitespace, nonnumeric, or
# outside 0..2, the whole GEO Brief provider config is disabled. Omit the
# variable entirely—not with an empty value—to use the task default 0.2.
