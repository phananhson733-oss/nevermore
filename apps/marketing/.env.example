# GenGrowth marketing website. Configure production values in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Identity Services client id. Enables the existing Google sign-in
# button used by registration-gated Agent runs; this is identity, not Gmail.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Production only. Leave unset on localhost and *.vercel.app previews.
SESSION_COOKIE_DOMAIN=
# Server-side durable crawl quota/cache. The current helper also accepts the
# newer SUPABASE_URL + SUPABASE_SECRET_KEY names.
SUPABASE_SERVICE_ROLE_KEY=
# Optional independent root for sealed marketing OAuth cookies (base64, 32+
# decoded bytes). TOKEN_ENCRYPTION_KEY remains the backwards-compatible root.
MARKETING_COOKIE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
UNSUBSCRIBE_SECRET=
## Keep true only while published blog_posts rows are being migrated to content/blog.
## Local Markdown always takes precedence for the same locale + slug.
BLOG_LEGACY_SUPABASE_ENABLED=true
