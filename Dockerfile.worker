FROM node:24-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
WORKDIR /app

# Pin Corepack as well as pnpm (root package.json pins pnpm@10.32.1).
RUN npm install --global corepack@0.34.5 && corepack enable pnpm

# Copy workspace manifests first so dependency installation remains cacheable.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/artifacts/package.json packages/artifacts/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/engine/package.json packages/engine/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/sources/package.json packages/sources/package.json

RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
USER node

# Node is PID 1 so the host's SIGTERM (Render/Railway) reaches the worker's
# graceful shutdown hook (pg-boss stop + readiness-lease release).
CMD ["node", "--enable-source-maps", "--import", "tsx", "apps/worker/src/index.ts"]
