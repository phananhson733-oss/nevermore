{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalframe.local/schemas/service-bundle-manifest/0.2.0",
  "title": "SignalFrame Service Bundle Manifest 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "contractVersion",
    "exportId",
    "projectId",
    "kind",
    "generatedAt",
    "outputLocale",
    "ruleSetVersion",
    "sourceSnapshotIds",
    "files",
    "itemCounts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "signalframe.service-bundle.0.2.0"
    },
    "productVersion": {
      "const": "0.2.0"
    },
    "contractVersion": {
      "const": "2026-07-18"
    },
    "exportId": {
      "$ref": "#/$defs/uuid"
    },
    "projectId": {
      "$ref": "#/$defs/uuid"
    },
    "kind": {
      "enum": ["service_bundle", "client_bundle"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputLocale": {
      "$ref": "#/$defs/locale"
    },
    "ruleSetVersion": {
      "const": "mvp.rules.0.2.0"
    },
    "sourceSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "contexts",
        "sources",
        "snapshots",
        "observations",
        "findings",
        "evidence",
        "actions",
        "artifacts",
        "artifactRevisions"
      ],
      "properties": {
        "projects": { "$ref": "#/$defs/count" },
        "contexts": { "$ref": "#/$defs/count" },
        "sources": { "$ref": "#/$defs/count" },
        "snapshots": { "$ref": "#/$defs/count" },
        "observations": { "$ref": "#/$defs/count" },
        "findings": { "$ref": "#/$defs/count" },
        "evidence": { "$ref": "#/$defs/count" },
        "actions": { "$ref": "#/$defs/count" },
        "artifacts": { "$ref": "#/$defs/count" },
        "artifactRevisions": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "mediaType"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "enum": [
            "application/json",
            "application/x-ndjson",
            "text/markdown; charset=utf-8",
            "text/csv; charset=utf-8"
          ]
        }
      }
    }
  }
}
