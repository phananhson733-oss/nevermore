{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalframe.local/schemas/service-bundle-manifest/0.2.0",
  "title": "SignalFrame Service Bundle Manifest 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "contractVersion",
    "exportId",
    "projectId",
    "kind",
    "generatedAt",
    "outputLocale",
    "ruleSetVersion",
    "sourceSnapshotIds",
    "files",
    "itemCounts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "signalframe.service-bundle.0.2.0"
    },
    "productVersion": {
      "const": "0.2.0"
    },
    "contractVersion": {
      "const": "2026-07-18"
    },
    "exportId": {
      "$ref": "#/$defs/uuid"
    },
    "projectId": {
      "$ref": "#/$defs/uuid"
    },
    "kind": {
      "enum": ["service_bundle", "client_bundle"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputLocale": {
      "$ref": "#/$defs/locale"
    },
    "ruleSetVersion": {
      "const": "mvp.rules.0.2.0"
    },
    "sourceSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "contexts",
        "sources",
        "snapshots",
        "observations",
        "findings",
        "evidence",
        "actions",
        "artifacts",
        "artifactRevisions"
      ],
      "properties": {
        "projects": { "$ref": "#/$defs/count" },
        "contexts": { "$ref": "#/$defs/count" },
        "sources": { "$ref": "#/$defs/count" },
        "snapshots": { "$ref": "#/$defs/count" },
        "observations": { "$ref": "#/$defs/count" },
        "findings": { "$ref": "#/$defs/count" },
        "evidence": { "$ref": "#/$defs/count" },
        "actions": { "$ref": "#/$defs/count" },
        "artifacts": { "$ref": "#/$defs/count" },
        "artifactRevisions": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "pattern": "^(?!(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*-((?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*-\\1(?:-|$))(?!(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*-([0-9A-WY-Za-wy-z])(?:-[A-Za-z0-9]{2,8})+(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*-\\2(?:-|$))(?:(?:[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}|[A-Za-z]{4}|[A-Za-z]{5,8})(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?|[Xx](?:-[A-Za-z0-9]{1,8})+|[Ee][Nn]-[Gg][Bb]-[Oo][Ee][Dd]|[Ii]-(?:[Aa][Mm][Ii]|[Bb][Nn][Nn]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Ee][Nn][Oo][Cc][Hh][Ii][Aa][Nn]|[Hh][Aa][Kk]|[Kk][Ll][Ii][Nn][Gg][Oo][Nn]|[Ll][Uu][Xx]|[Mm][Ii][Nn][Gg][Oo]|[Nn][Aa][Vv][Aa][Jj][Oo]|[Pp][Ww][Nn]|[Tt][Aa][Oo]|[Tt][Aa][Yy]|[Tt][Ss][Uu])|[Ss][Gg][Nn]-(?:[Bb][Ee]-(?:[Ff][Rr]|[Nn][Ll])|[Cc][Hh]-[Dd][Ee]))$",
      "description": "Structurally valid RFC 5646 language tag. This portable schema enforces subtag order, private use, irregular grandfathered tags, and same-case duplicate rejection; SignalFrame runtime and database validation additionally reject mixed-case duplicate variants or extension singletons."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "mediaType"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "enum": [
            "application/json",
            "application/x-ndjson",
            "text/markdown; charset=utf-8",
            "text/csv; charset=utf-8"
          ]
        }
      }
    }
  }
}
