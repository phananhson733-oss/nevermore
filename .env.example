# SignalFrame MVP 0.2.0 — environment contract (spec §3.4).
# Copy to .env.local for local development. Never commit real secrets.
# Startup performs Zod fail-fast validation; missing/invalid values abort boot.

# --- shared (web + worker) ---
# Origin only (scheme + host [+ port]); never include the base path here.
APP_ORIGIN=http://localhost:3000
# Web-only, BUILD TIME, for generic self-hosting under a sub-path. The approved
# app.gengrowth.ai production deployment leaves this unset and serves at root.
# When set, register the matching Google OAuth redirect URI
# (APP_ORIGIN + this + /api/mvp/oauth/google/callback) in Google Cloud Console.
# NEXT_PUBLIC_BASE_PATH=/portal
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/signalframe
# Per-process pool cap. Hosted web and worker each also create a pg-boss/session
# pool, so size this against the shared database connection limit.
DB_POOL_MAX=5
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=            # 32-byte base64 (AES-256-GCM). Generate: openssl rand -base64 32
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DATAFORSEO_ENABLED=false             # safe default; production enables explicitly
DATAFORSEO_MAX_KEYWORDS=200          # 1..1000; shared request cap, no secret
RAW_IMPORT_BUCKET=raw-imports
EXPORT_BUCKET=exports
# Hosted/production requires Supabase and rejects a local backend override.
# Local/test MUST point both web and worker at the same explicit absolute path;
# no path is inferred from either process's current working directory.
SF_BLOB_BACKEND=local
SF_BLOB_DIR=/absolute/path/to/signalframe-shared-blob
LOG_LEVEL=info

# --- web only ---
SUPABASE_ANON_KEY=
# Optional local-only auth bypass; production ignores it even if accidentally set.
# SF_DEV_AUTH=true

# --- worker only ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
LLM_PROVIDER=openai                  # fixed to openai in MVP; google adapter is interface-only
OPENAI_API_KEY=
OPENAI_MODEL=                        # pin an explicit model id at deploy time
# Azure OpenAI is an alternative host for the same `openai` provider. Comment
# out the direct pair above and provide ALL four fields below as a set. Keep
# these lines commented when using direct OpenAI: present-but-empty is invalid.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_VERSION=

# Optional explicit immutable build id. Vercel/Railway platform commit-SHA
# variables are used automatically when this is absent.
# APP_BUILD_SHA=
