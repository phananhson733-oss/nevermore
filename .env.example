# SignalFrame MVP 0.2.0 — environment contract (spec §3.4).
# Copy to .env.local for local development. Never commit real secrets.
# Startup performs Zod fail-fast validation; missing/invalid values abort boot.

# --- shared (web + worker) ---
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/signalframe
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=            # 32-byte base64 (AES-256-GCM). Generate: openssl rand -base64 32
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DATAFORSEO_ENABLED=false             # MUST be false in MVP (spec §3.4, §2.2)
RAW_IMPORT_BUCKET=raw-imports
EXPORT_BUCKET=exports
LOG_LEVEL=info

# --- web only ---
SUPABASE_ANON_KEY=

# --- worker only ---
LLM_PROVIDER=openai                  # fixed to openai in MVP; google adapter is interface-only
OPENAI_API_KEY=
OPENAI_MODEL=                        # pin an explicit model id at deploy time
